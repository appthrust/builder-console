{
  "openapi": "3.0.3",
  "info": {
    "title": "Builder Console built-in app API",
    "version": "1.0.0",
    "description": "Viewer-authorized app catalog for built-in app links. Existing console SPA routes share this API."
  },
  "x-appthrust-definition": "builder-console",
  "servers": [
    {
      "url": "/api/console"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/apps": {
      "get": {
        "operationId": "listApps",
        "summary": "List apps visible to the viewer",
        "description": "The default scope lists visible apps. group filters by Directory group ID including descendants; q matches app name, description, or tags. SPA-only scope variants are not part of the link operation.",
        "x-appthrust-link": true,
        "x-appthrust-result-path": "items",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppList"
                }
              }
            }
          },
          "403": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "operationId": "getApp",
        "summary": "Get an app visible to the viewer",
        "x-appthrust-link": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "404": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Person": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarVersion": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pending": {
            "type": "boolean"
          },
          "unknown": {
            "type": "boolean"
          }
        }
      },
      "AppGroup": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "SharePolicy": {
        "type": "object",
        "required": [
          "scope",
          "groupIds",
          "extraPersonIds"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "private",
              "group",
              "company",
              "public"
            ]
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraPersonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Screenshot": {
        "type": "object",
        "required": [
          "id",
          "caption",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "caption": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        }
      },
      "App": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "displayName",
          "description",
          "icon",
          "tags",
          "guide",
          "capabilities",
          "screenshots",
          "group",
          "owners",
          "stackId",
          "appName",
          "share",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guide": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Screenshot"
            }
          },
          "group": {
            "$ref": "#/components/schemas/AppGroup"
          },
          "owners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "stackId": {
            "type": "string",
            "nullable": true,
            "x-go-name": "StackID"
          },
          "appName": {
            "type": "string",
            "nullable": true
          },
          "share": {
            "$ref": "#/components/schemas/SharePolicy"
          },
          "createdBy": {
            "$ref": "#/components/schemas/Person"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AppList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
