{
  "openapi": "3.0.3",
  "info": {
    "title": "Builder Console built-in app API",
    "version": "1.0.0",
    "description": "Viewer-authorized app catalog and Console role-based views. App permissions are derived for the caller. Contribution defaults to group; only maintainers can change it. The inbox contains pending access requests and unseen feedback from other people on maintained apps, with zero counts omitted, ordered by kind (accessRequest, feedback) then latest activity descending. Same-origin Platform data, logs, rollback and improvement creation also enforce Console authority."
  },
  "x-appthrust-definition": "builder-console",
  "servers": [
    {
      "url": "/api/console"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the caller and relationship-based user or maker view",
        "responses": {
          "200": {
            "description": "Maker when a Console admin, group manager, or owner of any app; otherwise user",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Me"}}}
          }
        }
      }
    },
    "/inbox": {
      "get": {
        "operationId": "getInbox",
        "summary": "List pending access requests and unseen feedback for maintained apps",
        "responses": {
          "200": {
            "description": "Caller-specific inbox",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Inbox"}}}
          }
        }
      }
    },
    "/apps/{id}/comments/seen": {
      "post": {
        "operationId": "markCommentsSeen",
        "summary": "Mark this app's feedback seen by the caller",
        "description": "Requires maintain authority. Upserts the caller's last-seen timestamp to now.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "204": {"description": "Feedback marked seen"},
          "403": {"description": "Caller cannot maintain this app", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/apps/by-path/{path}": {
      "get": {
        "operationId": "getAppByPath",
        "summary": "Get a visible app by group path and slug",
        "parameters": [{"name": "path", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "App with caller permissions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/App"}}}}
        }
      }
    },
    "/apps/{id}/directory-entry": {
      "get": {
        "operationId": "getDirectoryEntry",
        "summary": "Get a bound app's introduction",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Introduction with caller permissions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DirectoryEntry"}}}}
        }
      }
    },
    "/apps": {
      "get": {
        "operationId": "listApps",
        "summary": "List apps visible to the viewer",
        "description": "The default scope lists visible apps. group filters by Directory group ID including descendants; q matches app name, description, or tags. SPA-only scope variants are not part of the link operation.",
        "x-appthrust-link": true,
        "x-appthrust-result-path": "items",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppList"
                }
              }
            }
          },
          "403": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "operationId": "getApp",
        "summary": "Get an app visible to the viewer",
        "x-appthrust-link": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "404": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateApp",
        "summary": "Update an app maintained by the caller",
        "description": "All fields, including contribution.scope and sharing, require maintain authority. Contribution uses the existing PATCH transaction semantics; no additional ETag or idempotency preconditions.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppPatch"}}}
        },
        "responses": {
          "200": {"description": "Updated app with caller permissions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/App"}}}},
          "400": {"description": "Invalid contribution scope or input", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "Caller cannot maintain this app", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ContributionPolicy": {
        "type": "object",
        "required": ["scope"],
        "properties": {"scope": {"type": "string", "enum": ["off", "group", "company"], "default": "group"}}
      },
      "Permissions": {
        "type": "object",
        "required": ["use", "comment", "propose", "maintain", "data"],
        "properties": {
          "use": {"type": "boolean"},
          "comment": {"type": "boolean"},
          "propose": {"type": "boolean"},
          "maintain": {"type": "boolean"},
          "data": {"type": "boolean", "description": "Interim policy equals maintain; remains a separate capability"}
        }
      },
      "AppPatch": {
        "type": "object",
        "properties": {
          "displayName": {"type": "string"},
          "description": {"type": "string"},
          "icon": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "guide": {"type": "string", "maxLength": 4000},
          "capabilities": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 60}},
          "groupId": {"type": "string"},
          "slug": {"type": "string"},
          "ownerIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "share": {"$ref": "#/components/schemas/SharePolicy"},
          "contribution": {"$ref": "#/components/schemas/ContributionPolicy"}
        }
      },
      "Me": {
        "type": "object",
        "required": ["person", "isConsoleAdmin", "canCreateApps", "effectiveGroupIds", "managedGroupIds", "projectId", "directoryPublicURL", "migration", "view"],
        "properties": {
          "person": {"$ref": "#/components/schemas/Person"},
          "isConsoleAdmin": {"type": "boolean"},
          "canCreateApps": {"type": "boolean"},
          "effectiveGroupIds": {"type": "array", "items": {"type": "string"}},
          "managedGroupIds": {"type": "array", "items": {"type": "string"}},
          "projectId": {"type": "string"},
          "directoryPublicURL": {"type": "string"},
          "platformUnavailable": {"type": "boolean"},
          "notMember": {"type": "boolean"},
          "teamSlug": {"type": "string"},
          "migration": {
            "type": "object",
            "required": ["pending", "groups", "memberships", "people"],
            "properties": {
              "pending": {"type": "boolean"},
              "groups": {"type": "integer"},
              "memberships": {"type": "integer"},
              "people": {"type": "integer"}
            }
          },
          "view": {"type": "string", "enum": ["user", "maker"]}
        }
      },
      "Inbox": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/InboxItem"}}
        }
      },
      "InboxItem": {
        "type": "object",
        "required": ["kind", "app", "count", "since"],
        "properties": {
          "kind": {"type": "string", "enum": ["accessRequest", "feedback"]},
          "app": {
            "type": "object",
            "required": ["id", "path", "displayName", "icon"],
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"},
              "displayName": {"type": "string"},
              "icon": {"type": "string"}
            }
          },
          "count": {"type": "integer", "minimum": 1},
          "since": {"type": "string", "format": "date-time"}
        }
      },
      "DirectoryEntry": {
        "type": "object",
        "required": ["id", "path", "displayName", "description", "icon", "tags", "capabilities", "screenshots", "group", "owners", "appName", "stackId", "createdAt", "updatedAt", "canOpen", "contribution", "permissions"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "displayName": {"type": "string"},
          "description": {"type": "string"},
          "icon": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "screenshots": {"type": "array", "items": {"$ref": "#/components/schemas/Screenshot"}},
          "group": {"$ref": "#/components/schemas/AppGroup"},
          "owners": {"type": "array", "items": {"$ref": "#/components/schemas/Person"}},
          "appName": {"type": "string", "nullable": true},
          "stackId": {"type": "string", "nullable": true},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "canOpen": {"type": "boolean"},
          "contribution": {"$ref": "#/components/schemas/ContributionPolicy"},
          "permissions": {"$ref": "#/components/schemas/Permissions"}
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarVersion": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pending": {
            "type": "boolean"
          },
          "unknown": {
            "type": "boolean"
          }
        }
      },
      "AppGroup": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "SharePolicy": {
        "type": "object",
        "required": [
          "scope",
          "groupIds",
          "extraPersonIds"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "private",
              "group",
              "company",
              "public"
            ]
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraPersonIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Screenshot": {
        "type": "object",
        "required": [
          "id",
          "caption",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "caption": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        }
      },
      "App": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "displayName",
          "description",
          "icon",
          "tags",
          "guide",
          "capabilities",
          "screenshots",
          "group",
          "owners",
          "stackId",
          "appName",
          "share",
          "contribution",
          "permissions",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-go-name": "ID"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guide": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Screenshot"
            }
          },
          "group": {
            "$ref": "#/components/schemas/AppGroup"
          },
          "owners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          },
          "stackId": {
            "type": "string",
            "nullable": true,
            "x-go-name": "StackID"
          },
          "appName": {
            "type": "string",
            "nullable": true
          },
          "share": {
            "$ref": "#/components/schemas/SharePolicy"
          },
          "contribution": {"$ref": "#/components/schemas/ContributionPolicy"},
          "permissions": {"$ref": "#/components/schemas/Permissions"},
          "createdBy": {
            "$ref": "#/components/schemas/Person"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AppList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
