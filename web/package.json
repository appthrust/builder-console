{
  "name": "@appthrust/builder-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "bun src/dev/mock-server.ts",
    "build": "tsc --noEmit && vite build",
    "build:image": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:mock": "playwright test --config e2e/playwright.config.ts --grep @mock"
  },
  "dependencies": {
    "@appthrust/api-schema": "^0.1.1",
    "@appthrust/app-launcher": "^0.1.3",
    "@appthrust/platform-dashboard-i18n": "^0.1.3",
    "@orpc/client": "^1.13.13",
    "@orpc/contract": "^1.13.13",
    "@orpc/openapi-client": "^1.13.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router-devtools": "^1.159.5",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "20.8.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
